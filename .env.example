# IT Certification Study App — local secrets / test environment (template)
#
# Copy this file to `.env` (in the same directory) and fill in real values.
# The actual `.env` is git-ignored; this `.env.example` is committed so the
# repo always documents which variables are expected.
#
# How to use locally:
#   cp .env.example .env
#   # edit .env with your real key
#   set -a; source .env; set +a
#   # any curl command can now reference $ANTHROPIC_API_KEY etc.

# ---------------------------------------------------------------------------
# Anthropic API key (one of two formats)
# ---------------------------------------------------------------------------
#   Anthropic Console:        sk-ant-api03-XXXX...
#   Claude Platform on AWS:   AEAAQ...==  (base64-looking bearer token)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# AWS workspace ID (only required when the key starts with "AEA")
# ---------------------------------------------------------------------------
# Find it at AWS Console -> Claude Platform on AWS -> Workspaces.
# Format: wrkspc_<random characters>
ANTHROPIC_AWS_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# AWS region for the Claude Platform endpoint (defaults to us-east-1)
# ---------------------------------------------------------------------------
ANTHROPIC_AWS_REGION=us-east-1
